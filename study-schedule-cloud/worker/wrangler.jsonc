{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "niypher-study-cloud-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:4173",
    "ENVIRONMENT": "development",
    "PBKDF2_ITERATIONS": "210000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "niypher-study-local",
      "database_id": "local-placeholder",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "AUTH_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "SYNC_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "ADMIN_RATE_LIMIT", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
    { "name": "TEMP_PASSWORD_RATE_LIMIT", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
