{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "ignorePatterns": ["src/js/lib/**/*.js"],
  "globals": {
    "turnstile": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "indent": ["error", 4],
    "linebreak-style": "off",
    "quotes": ["error", "single"],
    "semi": ["error", "always"],
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-undef": "warn",
    "prefer-const": "warn",
    "eqeqeq": ["error", "always"],
    "curly": ["error", "all"],
    "no-else-return": "error",
    "no-empty": "warn",
    "no-multi-spaces": "warn",
    "space-in-parens": ["error", "never"],
    "space-infix-ops": "error",
    "keyword-spacing": "error",
    "key-spacing": ["error", { "afterColon": true }],
    "comma-dangle": ["error", "never"],
    "arrow-spacing": "error",
    "no-trailing-spaces": "warn",
    "eol-last": ["error", "always"]
  }
}
