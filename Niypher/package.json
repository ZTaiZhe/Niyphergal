{
    "name":  "niypher",
    "version":  "1.0.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "vite build",
                    "preview":  "vite preview",
                    "lint":  "eslint src --ext .js,.jsx,.ts,.tsx",
                    "lint:fix":  "eslint src --ext .js,.jsx,.ts,.tsx --fix",
                    "format":  "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,html}\"",
                    "test":  "vitest",
                    "test:run":  "vitest run",
                    "deploy":  "wrangler pages deploy dist",
                    "build:deploy":  "npm run build \u0026\u0026 wrangler pages deploy dist",
                    "watch:deploy":  "chokidar \"src/**/*\" -d 3000 -c \"npm run build \u0026\u0026 wrangler pages deploy dist\""
                },
    "dependencies":  {
                         "@fontsource/jost":  "^5.2.8",
                         "framer-motion":  "^12.40.0",
                         "lucide-react":  "^1.16.0",
                         "motion":  "^12.40.0",
                         "pinyin-pro":  "^3.18.0",
                         "react":  "^19.2.6",
                         "react-dom":  "^19.2.6",
                         "react-router":  "^7.15.1",
                         "remixicon":  "^3.5.0",
                         "zustand":  "^5.0.13"
                     },
    "devDependencies":  {
                            "@tailwindcss/vite":  "^4.0.0",
                            "@vitejs/plugin-react":  "^4.7.0",
                            "chokidar-cli":  "^3.0.0",
                            "eslint":  "^8.57.0",
                            "jsdom":  "^24.0.0",
                            "prettier":  "^3.2.0",
                            "tailwindcss":  "^4.0.0",
                            "vite":  "^5.4.0",
                            "vitest":  "^1.3.0",
                            "wrangler":  "^4.98.0"
                        }
}
